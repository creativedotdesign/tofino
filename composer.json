{
  "name": "creativedotdesign/tofino",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "A WordPress starter theme for jumpstarting custom theme development.",
  "homepage": "https://github.com/creativedotdesign/tofino",
  "authors": [
    {
      "name": "Daniel Hewes",
      "email": "daniel@creativedotdesign.com",
      "homepage": "https://github.com/danimalweb"
    },
    {
      "name": "Jake Gully",
      "email": "chimpytk@gmail.com",
      "homepage": "https://github.com/mrchimp"
    }
  ],
  "keywords": [
    "WordPress",
    "theme",
    "tofino"
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "~v2.2.0",
    "enshrined/svg-sanitize": "^1.0",
    "league/html-to-markdown": "^5.1"
  },
  "autoload": {
    "psr-4": {
      "Tofino\\": "theme"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "require-dev": {
    "php-stubs/acf-pro-stubs": "^6.8",
    "phpstan/phpstan": "^2.3",
    "squizlabs/php_codesniffer": "^4.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wordpress-stubs": "^7.0"
  },
  "scripts": {
    "analyse:php": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
    "lint:php": "@php vendor/bin/phpcs --standard=phpcs.xml",
    "format:php": "@php vendor/bin/phpcbf --standard=phpcs.xml",
    "check:php": [
      "@analyse:php",
      "@lint:php"
    ]
  }
}
