# ignore all files starting with .
.*

# track this file .gitignore (i.e. do NOT ignore it)
!.gitignore
!.gitkeep
!.gitattributes
!.env.example
!.distignore
!.github
!.prettierrc

# ignore node/grunt dependency directories
node_modules/

# ignore composer dependency directories
/vendor/

# ignore dist directories
dist/
dist/hot
/build/
/dist-release/

# ignore npm debug log file
npm-debug.log
yarn-debug.log

# vitest
*.ts.snap
/test-results/
/tests/output/
/playwright-report/
/blob-report/
/playwright/.cache/

# Playwright
/accessibility-reports
